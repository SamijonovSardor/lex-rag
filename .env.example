# Scraper
LEXRAG_REQUEST_INTERVAL_S=1.0
LEXRAG_DATA_DIR=data

# Index (Phase 2): `docker compose up -d db`
LEXRAG_DATABASE_URL=postgresql://lexrag:lexrag@127.0.0.1:5434/lexrag
LEXRAG_EMBEDDING_MODEL=baai/bge-m3
# Which lex.uz id the API reports as doc_id: uz_cyrl (original act) or uz_latn
LEXRAG_CANONICAL_ID=uz_cyrl

# LLM / embeddings
OPENROUTER_API_KEY=
LEXRAG_LLM_MODEL=openai/gpt-6-luna

# API (Phase 6): comma-separated bearer keys for testers
LEXRAG_API_KEYS=

# Deploy: Neon direct connection string (scripts/copy_index.py)
LEXRAG_NEON_URL=
